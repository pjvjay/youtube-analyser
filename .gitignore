# Downloaded videos and the yt-dlp browser session: never commit these
*.mp4
*.mkv
*.webm
*.part
*.ytdl
cookies.txt

# Python
.venv/
__pycache__/
*.pyc

# Detector output that is bulky or contains video frames (results CSVs are kept)
standing/*/poses/
standing/*/frames/
standing/*/thumbs/
standing/*/review.html
standing/*/review*.csv
standing/trial*/

# Models not used by default (re-exportable, see standing/README.md)
standing/models/yolo26*.onnx

.DS_Store

# Per-video copies of the combined CSVs; they only mark progress for resuming a run
standing/*/segments/
standing/*/dropped/
standing/*/intro/
standing/*/interview/

# Local only: anything that names or is made from the videos (inventory, yt-dlp archive, results,
# manual review, detector output, the title-frame bank). samples/ shows the formats with made-up names.
/analysis/
/results/
/standing/output/
/standing/models/intro_bank.npz
/archive.txt
/long_ids.txt
